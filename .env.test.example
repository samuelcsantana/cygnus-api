# Used by `npm test` (see package.json) so integration tests never touch the database
# behind your local docker-compose stack — they run destructive deleteMany() cleanup
# between tests, which would otherwise wipe the users/babies you created manually.
# Same values as .env.example, except POSTGRES_DB/DATABASE_URL point at a separate
# database (cygnus_db_test) on the same Postgres server. Create it once with:
#   docker exec cygnus-postgres psql -U cygnus_user -d postgres -c "CREATE DATABASE cygnus_db_test OWNER cygnus_user;"
#   npm run test:migrate
# REDIS_URL also points at a separate logical database (/1 instead of /0, the
# implicit default) on the same Redis instance — CachedVaccineRepository caches
# the vaccine catalog for 1h with no invalidation, so without this, tests share
# a cache key ("vaccines:catalog") with local dev and can read back vaccine ids
# from whichever Postgres database last populated the cache.

NODE_ENV=test
PORT=3005
HOST=0.0.0.0

CORS_ORIGIN=http://localhost:4205

POSTGRES_USER=cygnus_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=cygnus_db_test
POSTGRES_PORT=5433
DATABASE_URL=postgresql://cygnus_user:your_postgres_password_here@localhost:5433/cygnus_db_test?schema=public

REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379
REDIS_URL=redis://:your_redis_password_here@localhost:6379/1

JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Resend (transactional email). Left unset in test — EmailService no-ops with a warning log
# instead of throwing, so the integration suite never sends real emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cygnus <onboarding@resend.dev>
