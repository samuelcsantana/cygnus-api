# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# CORS (Angular frontend origin)
CORS_ORIGIN=http://localhost:4200

# PostgreSQL (used by docker-compose and Prisma)
POSTGRES_USER=meunenem_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=meunenem_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://meunenem_user:your_postgres_password_here@localhost:5433/meunenem_db?schema=public

# Redis
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379
REDIS_URL=redis://:your_redis_password_here@localhost:6379

# JWT (placeholders for the upcoming Auth feature)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
