# Application
NODE_ENV=development
PORT=3005
HOST=0.0.0.0
# Optional: overrides whether auth cookies are marked `Secure` (defaults to NODE_ENV === 'production').
# Set to 'false' when running the production Docker image locally over plain HTTP.
# SECURE_COOKIES=true

# CORS (React/Vite frontend origin)
CORS_ORIGIN=http://localhost:4205

# PostgreSQL (used by docker-compose and Prisma)
POSTGRES_USER=cygnus_user
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=cygnus_db
POSTGRES_PORT=5433
DATABASE_URL=postgresql://cygnus_user:your_postgres_password_here@localhost:5433/cygnus_db?schema=public

# Redis
REDIS_PASSWORD=your_redis_password_here
REDIS_PORT=6379
REDIS_URL=redis://:your_redis_password_here@localhost:6379

# JWT (must be at least 32 characters long — generate with `openssl rand -hex 32`)
JWT_ACCESS_SECRET=your_jwt_access_secret_here_min_32_characters
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Resend (transactional email — guardian invites, later reminder emails). Optional: EmailService
# no-ops with a warning log when unset, so local dev/CI works without a real account.
#
# onboarding@resend.dev is Resend's own sandbox sender, and it is not merely a weaker production
# sender: it delivers ONLY to the address that owns the Resend account. A guardian invite to
# anyone else is accepted by the API, returns no error, and never arrives — which is the whole
# use case failing silently. Anything real needs a `from` on a domain verified in the Resend
# dashboard; production uses samuelsantana.dev.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cygnus <onboarding@resend.dev>
