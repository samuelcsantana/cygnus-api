# Build output
/dist/
/dist-seed/
/coverage/

# User-uploaded files (served via @fastify/static, persisted via a Docker volume in prod)
/uploads/

# Node
/node_modules/

# Environment files
/.env
/.env.test
/.env.*.local

# TypeScript cache
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Prisma 7 generates the client into src/ — regenerated by `prisma generate`,
# never edited by hand, so it is build output rather than source.
/src/generated/

# Agent instructions and planning docs — kept on disk, out of the public repo.
# CLAUDE.md documents how docs/ is laid out; see its "Planning docs" section.
/CLAUDE.md
/docs/
