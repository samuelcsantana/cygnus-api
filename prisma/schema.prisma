generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                        String            @id @default(uuid())
  email                     String            @unique
  passwordHash              String            @map("password_hash")
  name                      String
  emailNotificationsEnabled Boolean           @default(true) @map("email_notifications_enabled")
  createdAt                 DateTime          @default(now()) @map("created_at")
  // How "log every other device out" is expressed: refresh tokens carry the version they were
  // minted under, and a password reset increments this, so every token issued before it stops
  // matching. A counter rather than a timestamp because `iat` only has second resolution — a
  // time-based cutoff would keep alive exactly the tokens issued in the same second as the reset.
  // Starts at 0 so tokens already in the wild, which carry no version claim at all, keep working.
  // Lives in Postgres, not Redis: a Key Value flush must never un-invalidate a session.
  sessionVersion            Int               @default(0) @map("session_version")
  babies                    Baby[]
  notifications             Notification[]
  babyGuardianships         BabyGuardian[]
  legalAcceptances          LegalAcceptance[]

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
}

enum GuardianRole {
  OWNER
  GUARDIAN
}

model Baby {
  id               String              @id @default(uuid())
  userId           String              @map("user_id")
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  birthDate        DateTime            @map("birth_date") @db.Date
  gender           Gender
  bloodType        String?             @map("blood_type")
  allergies        String[]            @default([])
  // Stored as a pair because the plan's name alone is not what a clinic desk asks for — it asks
  // for the member number. One without the other still sends the parent digging for the card.
  healthPlanName   String?             @map("health_plan_name")
  healthPlanNumber String?             @map("health_plan_number")
  avatarUrl        String?             @map("avatar_url")
  avatarColor      String?             @map("avatar_color")
  createdAt        DateTime            @default(now()) @map("created_at")
  vaccineRecords   BabyVaccineRecord[]
  appointments     Appointment[]
  milestones       Milestone[]
  notifications    Notification[]
  guardians        BabyGuardian[]
  invites          BabyInvite[]
  specialists      Specialist[]
  medications      Medication[]

  @@index([userId])
  @@map("babies")
}

// A baby profile can be jointly managed by more than one adult (e.g. both parents). `Baby.userId`
// stays as the "created by" reference, but access control for reads/writes is decided solely by
// the presence of a `BabyGuardian` row for (babyId, userId) — see `ensureBabyAccess`.
model BabyGuardian {
  id        String       @id @default(uuid())
  babyId    String       @map("baby_id")
  baby      Baby         @relation(fields: [babyId], references: [id], onDelete: Cascade)
  userId    String       @map("user_id")
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GuardianRole @default(GUARDIAN)
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([babyId, userId])
  @@index([userId])
  @@map("baby_guardians")
}

// A shareable code (optionally tied to an invitee email) that grants GUARDIAN access to a baby
// once redeemed. Single-use and time-limited (see `expiresAt`).
model BabyInvite {
  id              String    @id @default(uuid())
  babyId          String    @map("baby_id")
  baby            Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  code            String    @unique
  createdByUserId String    @map("created_by_user_id")
  inviteeEmail    String?   @map("invitee_email")
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  usedByUserId    String?   @map("used_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@map("baby_invites")
}

model Vaccine {
  id                     String                    @id @default(uuid())
  code                   String
  name                   String
  description            String
  guidance               String?
  recommendedAgeInMonths Int                       @map("recommended_age_in_months")
  doseNumber             Int                       @map("dose_number")
  recommendationKind     VaccineRecommendationKind @default(ROUTINE) @map("recommendation_kind")
  scheduleVersion        String                    @map("schedule_version")
  effectiveFrom          DateTime                  @map("effective_from") @db.Date
  effectiveTo            DateTime?                 @map("effective_to") @db.Date
  isActive               Boolean                   @default(true) @map("is_active")
  createdAt              DateTime                  @default(now()) @map("created_at")
  records                BabyVaccineRecord[]

  @@unique([scheduleVersion, code])
  @@index([isActive, recommendedAgeInMonths])
  @@map("vaccines")
}

enum VaccineRecommendationKind {
  ROUTINE
  CONDITIONAL
  RECURRING
}

enum VaccineRecordStatus {
  PENDING
  APPLIED
  DELAYED
}

enum VaccineRecordSource {
  CATALOG
  CAMPAIGN
  CUSTOM
}

model BabyVaccineRecord {
  id              String              @id @default(uuid())
  babyId          String              @map("baby_id")
  baby            Baby                @relation(fields: [babyId], references: [id], onDelete: Cascade)
  vaccineId       String?             @map("vaccine_id")
  vaccine         Vaccine?            @relation(fields: [vaccineId], references: [id], onDelete: Cascade)
  source          VaccineRecordSource @default(CATALOG)
  customName      String?             @map("custom_name")
  customDose      String?             @map("custom_dose")
  status          VaccineRecordStatus
  applicationDate DateTime?           @map("application_date") @db.Date
  notes           String?
  batchNumber     String?             @map("batch_number")
  location        String?
  professional    String?
  photoUrl        String?             @map("photo_url")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@unique([babyId, vaccineId])
  @@map("baby_vaccine_records")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// The people who look after a child: the paediatrician, the physio, the speech therapist. Kept per
// baby rather than per account because access in this schema is decided baby by baby — a
// `BabyGuardian` row is what grants a read, and there is no concept of a family. A specialist
// hanging off the account would be invisible to the other guardian, which would take back the
// sharing that already works.
model Specialist {
  id           String        @id @default(uuid())
  babyId       String        @map("baby_id")
  baby         Baby          @relation(fields: [babyId], references: [id], onDelete: Cascade)
  name         String
  specialty    String?
  // The number somebody looks for at 3am, which is the whole reason this table exists: an
  // appointment's `doctorName` is free text and has nowhere to hang a phone number.
  phone        String?
  createdAt    DateTime      @default(now()) @map("created_at")
  appointments Appointment[]

  @@index([babyId])
  @@map("specialists")
}

// What a child was prescribed, and when — a record, never an instruction.
//
// Everything else in this app registers the past: a vaccine was applied, a milestone was reached.
// A medication is the first thing here that describes something ongoing, which is exactly why the
// shape stays descriptive: `startedOn`/`endedOn` say what a prescription covered, and nothing in
// the model expresses "take this now". Dose and frequency are free text because the units are not
// enumerable in any useful way — drops, ml, mg, half a tablet — and a field that refuses what the
// prescription actually says is worse than one that stores it verbatim.
model Medication {
  id             String    @id @default(uuid())
  babyId         String    @map("baby_id")
  baby           Baby      @relation(fields: [babyId], references: [id], onDelete: Cascade)
  name           String
  dosage         String?
  frequency      String?
  reason         String?
  prescriberName String?   @map("prescriber_name")
  startedOn      DateTime  @map("started_on") @db.Date
  // Null means the course has no recorded end — still being taken, as far as this record knows.
  // "As far as this record knows" is the whole claim: nothing here watches a clock.
  endedOn        DateTime? @map("ended_on") @db.Date
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([babyId])
  @@map("medications")
}

model Appointment {
  id                String            @id @default(uuid())
  babyId            String            @map("baby_id")
  baby              Baby              @relation(fields: [babyId], references: [id], onDelete: Cascade)
  scheduledAt       DateTime          @map("scheduled_at")
  doctorName        String            @map("doctor_name")
  specialty         String?
  location          String?
  reason            String?
  notes             String?
  status            AppointmentStatus @default(SCHEDULED)
  // Optional, and beside `doctorName` rather than replacing it. `SetNull` is load-bearing: tidying
  // up the address book must never rewrite a visit that happened, and the name typed on the day
  // stays even when the specialist row is gone. A health record does not lose information because
  // somebody cleaned a list.
  specialistId      String?           @map("specialist_id")
  specialist        Specialist?       @relation(fields: [specialistId], references: [id], onDelete: SetNull)
  // Integers in the smallest unit the instrument reads, not decimals: these are the raw material
  // of a growth curve, so they get summed, averaged and interpolated. A float that survives a
  // round trip through JSON and JS arithmetic prints 15.799999999999999 sooner or later, and the
  // unit is in the name so no consumer has to guess whether 15.8 meant kilos or pounds.
  weightGrams       Int?              @map("weight_grams")
  heightMillimeters Int?              @map("height_millimeters")
  createdAt         DateTime          @default(now()) @map("created_at")

  @@index([babyId])
  @@index([specialistId])
  @@map("appointments")
}

enum MilestoneCategory {
  MOTOR
  LANGUAGE
  SOCIAL
  COGNITIVE
  OTHER
}

model Milestone {
  id          String            @id @default(uuid())
  babyId      String            @map("baby_id")
  baby        Baby              @relation(fields: [babyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  achievedAt  DateTime          @map("achieved_at") @db.Date
  category    MilestoneCategory
  photoUrl    String?           @map("photo_url")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([babyId])
  @@map("milestones")
}

enum NotificationType {
  VACCINE_DELAYED
  APPOINTMENT_UPCOMING
}

model Notification {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  babyId      String           @map("baby_id")
  baby        Baby             @relation(fields: [babyId], references: [id], onDelete: Cascade)
  type        NotificationType
  referenceId String           @map("reference_id")
  title       String
  message     String
  readAt      DateTime?        @map("read_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  @@unique([babyId, type, referenceId])
  @@index([userId])
  @@map("notifications")
}

// Lightweight audit trail for who touched a child's health data (vaccines, appointments,
// milestones) and when — not a full change-history/versioning table, just an append-only log.
model AuditLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String   @map("resource_id")
  babyId       String?  @map("baby_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([babyId])
  @@index([userId])
  @@map("audit_logs")
}

/// One row per (user, document, version) they have accepted.
///
/// Versioned rather than a boolean, because consent to a text that has since changed is not
/// consent to the current one: raising a document's version is what makes everyone accept again,
/// and what makes the record auditable instead of a flag nobody can date.
///
/// documentId is a String, not an enum, and that is deliberate. The wire values are fixed by the
/// frontend's document registry and are lowercase ('privacy', 'terms'); the route's Zod schema is
/// what constrains them, and it is the same schema the OpenAPI document is generated from, so the
/// contract still states exactly which two values are legal. A database enum would only add a
/// case-translation layer whose whole job is to undo itself.
model LegalAcceptance {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  documentId String   @map("document_id")
  version    String
  acceptedAt DateTime @default(now()) @map("accepted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentId, version])
  @@index([userId])
  @@map("legal_acceptances")
}
